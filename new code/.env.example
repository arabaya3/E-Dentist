# E-Dentist Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# Note: In Docker, DATABASE_URL is automatically set
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=edentist
MYSQL_USER=edentist
MYSQL_PASSWORD=edentist123
MYSQL_PORT=3306

# Authentication & Security
EDENTIST_AUTH_CLIENT_ID=your_client_id
EDENTIST_AUTH_CLIENT_SECRET=your_client_secret
EDENTIST_JWT_SECRET=your_jwt_secret_here_min_32_chars
EDENTIST_AES_PASSPHRASE=your_aes_passphrase
EDENTIST_AES_KEY=your_aes_key

# External API Configuration
AGENT_API_BASE_URL=https://your-api-url.com
EDENTIST_API_BASE_URL=https://edentist-be-stage-576483531725.europe-west1.run.app/api/v1

# Google Cloud Storage
GCS_BUCKET_NAME=edentist-voice-recordings

# Server Configuration
PORT=5000
NODE_ENV=production

# Analytics
REACT_APP_ENABLE_ANALYTICS=false
